# ===========================================================================
# Multilingual file for the TOS 7 Docker application "backrestdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language；
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"； run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Backrest"
auth         = "garethgeorge"
version      = "@@VERSION@@"
descript     = "Backrest is a friendly web UI on top of restic: create encrypted backups of folders mounted into the container to a local disk, S3, SFTP or another restic backend, schedule them, browse and restore snapshots, and apply retention policies - without typing restic commands. Configuration, operation logs and the restic cache live in the application data folder."
release_note = "3. Rectified per review comments (F5, F8, plus C2, C3-C8, C9, C10, T1). Added the missing writable /cache mount: the image sets XDG_CACHE_HOME=/cache and restic aborts every command with 'unable to open cache: mkdir /cache: permission denied' without it, which made backup, snapshot listing and restore fail with HTTP 500. The cache directory is now declared in the compose file and inside the application data folder, and the persistence text of every language lists config, data and cache. Added PRIVACY.md and NOTICE.md, completed the README, corrected the upstream licence to GPL-3.0, disclosed the third-party endpoints (Docker Hub, user-configured restic backends, optional notifications), dropped all capabilities and enabled no-new-privileges. The image is still the newest upstream release, v1.14.1. Both x86_64 and aarch64 packages are submitted."
important    = "Requires DockerEngine (installed if missing). Open the web UI, add a repository (a path below /data, or an S3/SFTP/WebDAV endpoint) and a plan. Each repository password is required to restore, so keep it safe. Only /config, /data and /cache are mounted, so plans cover those paths or a remote backend. Config, operation log and restic cache live in DockerAppData/backrestdocker and survive updates. The UI has no built-in login - keep it on the LAN or front it with a TLS reverse proxy that authenticates."

[zh-cn]
name         = "Backrest"
auth         = "garethgeorge"
version      = "@@VERSION@@"
descript     = "Backrest 是 restic 的友好网页界面：把挂载进容器的目录加密备份到本地磁盘、S3、SFTP 或其他 restic 后端，支持定时计划、浏览与恢复快照、保留策略，不用手敲 restic 命令。配置、操作日志与 restic 缓存都保存在应用数据目录。"
release_note = "3. 按审核意见整改（F5、F8，同时处理 C2、C3-C8、C9、C10、T1）。补上缺失的可写 /cache 挂载：镜像把 XDG_CACHE_HOME 设为 /cache，缺失时 restic 直接报「unable to open cache: mkdir /cache: permission denied」，导致备份、快照列表与恢复全部返回 HTTP 500。现在 compose 声明了 cache 目录，应用数据目录也包含它，各语言持久化说明统一写成 config、data、cache 三个目录。新增 PRIVACY.md 与 NOTICE.md，补全 README，把上游许可证更正为 GPL-3.0，披露第三方端点（Docker Hub、用户配置的 restic 后端、可选通知），丢弃全部能力并启用 no-new-privileges。镜像仍为上游最新版 v1.14.1。x86_64 与 aarch64 两个架构都已重新提交。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。打开界面后添加仓库（/data 下的路径，或 S3/SFTP/WebDAV 地址）和计划；每个仓库的密码是恢复时必需的，请妥善保存。容器内只挂载了 /config、/data、/cache 三个目录，备份源只能是这些路径或远端后端。配置、操作日志与 restic 缓存保存在 DockerAppData/backrestdocker，升级不丢失。界面本身没有登录功能，请只在局域网使用，或在前端加带 TLS 与认证的反向代理。"

[zh-hk]
name         = "Backrest"
auth         = "garethgeorge"
version      = "@@VERSION@@"
descript     = "Backrest 是 restic 的友善網頁介面：把掛載進容器的目錄加密備份到本機磁碟、S3、SFTP 或其他 restic 後端，支援定時計畫、瀏覽與還原快照、保留策略，不用手敲 restic 指令。設定、操作日誌與 restic 快取都保存在應用資料目錄。"
release_note = "3. 按審核意見整改（F5、F8，同時處理 C2、C3-C8、C9、C10、T1）。補上缺少的可寫 /cache 掛載：映像把 XDG_CACHE_HOME 設為 /cache，缺少時 restic 直接報「unable to open cache: mkdir /cache: permission denied」，導致備份、快照列表與還原全部回傳 HTTP 500。現在 compose 宣告了 cache 目錄，應用資料目錄也包含它，各語言持久化說明統一寫成 config、data、cache 三個目錄。新增 PRIVACY.md 與 NOTICE.md，補齊 README，把上游授權更正為 GPL-3.0，揭露第三方端點（Docker Hub、使用者設定的 restic 後端、可選通知），捨棄全部能力並啟用 no-new-privileges。映像仍為上游最新版 v1.14.1。x86_64 與 aarch64 兩個架構都已重新提交。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。開啟介面後新增倉庫（/data 下的路徑，或 S3/SFTP/WebDAV 位址）和計畫；每個倉庫的密碼是還原時必需的，請妥善保存。容器內只掛載了 /config、/data、/cache 三個目錄，備份來源只能是這些路徑或遠端後端。設定、操作日誌與 restic 快取保存在 DockerAppData/backrestdocker，升級不遺失。介面本身沒有登入功能，請只在區域網路使用，或在前端加帶 TLS 與認證的反向代理。"

